flowchart TD
  sender["Sender: a webhook or script<br/>on another device<br/>Host: the name it used"]
  proxy["Proxy on this machine<br/>sends Host: localhost<br/>sets X-Forwarded-For<br/>to the sender's address"]
  host["Kraft on 127.0.0.1<br/>checks the Host"]
  client["Kraft takes the client<br/>from X-Forwarded-For"]
  token["Kraft asks for a credential:<br/>session, mcp-token bearer,<br/>or trigger token on<br/>POST /api/triggers"]
  api(["API answers"])
  r403(["403<br/>unexpected Host"])
  open(["No sign-in asked:<br/>the whole API is open"])
  r401(["401<br/>no valid credential"])

  sender --> proxy --> host
  host -->|"localhost"| client
  host -->|"any other"| r403
  client -->|"a remote<br/>address"| token
  client -->|"header<br/>missing"| open
  token -->|"valid"| api
  token -->|"none valid"| r401

  classDef box fill:#eef0f3,stroke:#7b8494,color:#1d1d1f
  class sender,proxy,host,client,token,api,r403,open,r401 box
  linkStyle default stroke:#7b8494
