flowchart TD
  measure["Measure the node:<br/>read every task's<br/>findings"]
  open["A finding at a loop<br/>severity, or a task<br/>failed with none?"]
  cycle["One cycle, checks in order:<br/>needs_context,<br/>only Kraft-run failures,<br/>budget, the judge when due,<br/>attempt or wall-clock limit,<br/>same findings again"]
  repair["Repair task,<br/>told the failing<br/>findings"]
  pass(["Node<br/>completes"])
  stuck(["Node stuck:<br/>escalation first,<br/>then the item<br/>waits for you"])

  measure --> open
  open -->|"no"| pass
  open -->|"yes"| cycle
  cycle -->|"nothing<br/>stops it"| repair
  repair -->|"measure the<br/>whole node again"| measure
  cycle -->|"judge:<br/>stop_downgrade"| pass
  cycle -->|"attempts or wall clock<br/>past the limit, same<br/>findings again, or judge:<br/>stop_needs_human"| stuck

  classDef box fill:#eef0f3,stroke:#7b8494,color:#1d1d1f
  class measure,open,cycle,repair,pass,stuck box
  linkStyle default stroke:#7b8494
