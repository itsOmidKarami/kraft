  "themeVariables": {
    "fontFamily": "'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif",
    "fontSize": "15px",
    "primaryColor": "#f1f5f9",
    "primaryBorderColor": "#64748b",
    "primaryTextColor": "#0f172a",
    "nodeBorder": "#64748b",
    "mainBkg": "#f1f5f9",
    "lineColor": "#64748b",
    "edgeLabelBackground": "#f1f5f9"
  },
  "themeCSS": ".edgeLabel rect { opacity: 1; } .cluster-label text, .cluster-label tspan, text.actor, text.actor > tspan { font-family: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace; font-weight: 600; }"
