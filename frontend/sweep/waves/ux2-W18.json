{
  "title": "UX V2 cutover: the new UI at /, every earlier ux2 rule under the plain names",
  "screens": "all",
  "specs": ["sweep.spec.ts", "interactions.spec.ts"],
  "rules": [
    { "kind": "no-flag", "flag": "contrast", "match": "^(?!flow-)" },
    { "kind": "no-flag", "flag": "offscreen", "match": "^(?!flow-)" },
    { "kind": "no-flag", "flag": "clipped-v", "match": "^(?!flow-)" },
    { "kind": "no-flag", "flag": "target<44", "match": "^phone-" },
    { "kind": "no-flag", "flag": "input<16", "match": "^phone-" },
    { "kind": "no-flag", "flag": "overflow-x", "match": "^phone-" },
    { "kind": "no-console", "match": "^(?!flow-|login/|phone-login/|board/(loading|offline)|new-item/error|search/docs-error|chains/review-stale|policy/review-stale|item-cap/editor-refused|phone-board/offline|phone-area/policy-stale)" },
    { "kind": "flow-completes", "match": "^flow-" },
    { "kind": "max-count", "check": "nestedScrollers", "max": 2, "match": "^(item|review|gate-review|board|board-peek|new-item|draft-item|archived|phone)" }
  ]
}
