{
  "title": "UX V2 fix: the ⌘K document and bead hits stay inside /ng",
  "screens": [
    "ng-search-doc",
    "ng-item-doc",
    "ng-draft-item",
    "flow-ng-search-doc-keyboard",
    "flow-ng-search-free-doc-focus"
  ],
  "specs": [
    "sweep.spec.ts",
    "interactions.spec.ts"
  ],
  "rules": [
    { "kind": "no-flag", "flag": "offscreen", "match": "^ng-(search-doc|item-doc|draft-item)/" },
    { "kind": "no-flag", "flag": "clipped-v", "match": "^ng-(search-doc|item-doc|draft-item)/" },
    { "kind": "no-flag", "flag": "contrast", "match": "^ng-(search-doc|item-doc|draft-item)/" },
    { "kind": "no-console", "match": "^ng-(search-doc|item-doc|draft-item)/" },
    { "kind": "flow-completes", "match": "^flow-ng-search-" }
  ]
}
