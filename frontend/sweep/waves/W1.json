{
  "title": "Light mode",
  "screens": [
    "board",
    "board-peek",
    "item",
    "item-tasks",
    "item-documents",
    "settings-repos",
    "settings-policy",
    "analytics",
    "login",
    "new-item",
    "search"
  ],
  "specs": [
    "sweep.spec.ts"
  ],
  "rules": [
    {
      "kind": "no-flag",
      "flag": "contrast",
      "match": "~light"
    },
    {
      "kind": "no-console",
      "match": "~light"
    },
    {
      "kind": "no-flag-increase",
      "flag": "contrast",
      "match": "^(?!.*~light)"
    }
  ]
}
