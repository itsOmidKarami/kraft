{
  "title": "UX V2 item page: header, state cards, chain canvas and pane, node, task and gate panes",
  "screens": [
    "ng-item",
    "flow-ng-cancel",
    "flow-ng-pane-collapse",
    "flow-ng-node-keyboard",
    "flow-ng-retry-task"
  ],
  "specs": [
    "sweep.spec.ts",
    "interactions.spec.ts"
  ],
  "rules": [
    {
      "kind": "no-flag",
      "flag": "offscreen",
      "match": "^ng-item"
    },
    {
      "kind": "no-flag",
      "flag": "clipped-v",
      "match": "^ng-item"
    },
    {
      "kind": "no-flag",
      "flag": "contrast",
      "match": "^ng-item"
    },
    {
      "kind": "no-console",
      "match": "^ng-item"
    },
    {
      "kind": "flow-completes",
      "match": "^flow-ng-"
    },
    {
      "kind": "max-count",
      "check": "nestedScrollers",
      "max": 2,
      "match": "^ng-item"
    }
  ]
}
