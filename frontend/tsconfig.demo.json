{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./node_modules/.tmp/demo-build",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.demo.tsbuildinfo",
    "types": ["vite/client"],
    "resolveJsonModule": true
  },
  "include": ["demo/**/*.ts", "e2e/contract/mocks/*.ts", "e2e/contract/mocks/*.json"],
  "exclude": ["demo/**/*.test.ts", "e2e/contract/mocks/playwright.ts"],
  "references": [{ "path": "./tsconfig.app.json" }]
}
