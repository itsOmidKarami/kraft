{
  "name": "kraft",
  "displayName": "Kraft",
  "description": "Approve gates, review diffs and edit config for Kraft, the local orchestrator for your coding agent, without leaving VS Code.",
  "version": "2.0.0",
  "publisher": "kraft-sdlc",
  "license": "Apache-2.0",
  "icon": "media/kraft.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsOmidKarami/kraft"
  },
  "homepage": "https://itsomidkarami.github.io/kraft/guides/vscode",
  "bugs": {
    "url": "https://github.com/itsOmidKarami/kraft/issues"
  },
  "qna": "https://github.com/itsOmidKarami/kraft/issues",
  "galleryBanner": {
    "color": "#161826",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI"
  ],
  "keywords": [
    "kraft",
    "agent",
    "coding agent",
    "ai agents",
    "claude",
    "claude code",
    "codex",
    "orchestrator",
    "agent orchestration",
    "code review",
    "pull request",
    "merge request",
    "spec",
    "sdlc",
    "agentic-sdlc",
    "workflow",
    "human in the loop",
    "approval"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:yaml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode Kraft shows the board and gates read-only and does not check config files in the workspace.",
      "restrictedConfigurations": [
        "kraft.url"
      ]
    }
  },
  "contributes": {
    "configuration": {
      "title": "Kraft",
      "properties": {
        "kraft.url": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Kraft daemon URL, set in user or Remote settings only. Empty: read KRAFT_HOST and KRAFT_PORT, then bind and port from $KRAFT_HOME/config/access.yaml."
        },
        "kraft.notifications": {
          "type": "string",
          "enum": [
            "all",
            "gates",
            "off"
          ],
          "default": "all",
          "description": "Which Kraft states raise a notification."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kraft",
          "title": "Kraft",
          "icon": "media/kraft.svg"
        }
      ]
    },
    "views": {
      "kraft": [
        {
          "id": "kraft.board",
          "name": "Board"
        }
      ]
    },
    "commands": [
      {
        "command": "kraft.pause",
        "title": "Pause",
        "category": "Kraft"
      },
      {
        "command": "kraft.resume",
        "title": "Resume\u2026",
        "category": "Kraft"
      },
      {
        "command": "kraft.retry",
        "title": "Retry\u2026",
        "category": "Kraft"
      },
      {
        "command": "kraft.cancel",
        "title": "Cancel",
        "category": "Kraft"
      },
      {
        "command": "kraft.skip",
        "title": "Skip",
        "category": "Kraft"
      },
      {
        "command": "kraft.escalate",
        "title": "Escalate\u2026",
        "category": "Kraft"
      },
      {
        "command": "kraft.archive",
        "title": "Archive",
        "category": "Kraft"
      },
      {
        "command": "kraft.raiseBudget",
        "title": "Raise Budget\u2026",
        "category": "Kraft"
      },
      {
        "command": "kraft.unblock",
        "title": "Unblock",
        "category": "Kraft"
      },
      {
        "command": "kraft.complete",
        "title": "Complete\u2026",
        "category": "Kraft"
      },
      {
        "command": "kraft.restore",
        "title": "Restore",
        "category": "Kraft"
      },
      {
        "command": "kraft.openWorktree",
        "title": "Open Worktree in New Window",
        "category": "Kraft"
      },
      {
        "command": "kraft.openInWebUi",
        "title": "Open in Web UI",
        "category": "Kraft"
      },
      {
        "command": "kraft.showWorkerLog",
        "title": "Show Worker Log",
        "category": "Kraft"
      },
      {
        "command": "kraft.openMergeRequest",
        "title": "Open Merge Request",
        "category": "Kraft"
      },
      {
        "command": "kraft.openSpec",
        "title": "Open Spec",
        "category": "Kraft"
      },
      {
        "command": "kraft.openPlan",
        "title": "Open Plan",
        "category": "Kraft"
      },
      {
        "command": "kraft.toggleAllRepos",
        "title": "Show All Repos",
        "category": "Kraft",
        "icon": "$(filter)"
      },
      {
        "command": "kraft.startDaemon",
        "title": "Start Kraft",
        "category": "Kraft"
      },
      {
        "command": "kraft.showLog",
        "title": "Show Log",
        "category": "Kraft"
      },
      {
        "command": "kraft.statusMenu",
        "title": "Status Menu",
        "category": "Kraft"
      },
      {
        "command": "kraft.openArtifact",
        "title": "Open Gate Document",
        "category": "Kraft"
      },
      {
        "command": "kraft.approve",
        "title": "Approve",
        "category": "Kraft"
      },
      {
        "command": "kraft.reject",
        "title": "Reject\u2026",
        "category": "Kraft"
      },
      {
        "command": "kraft.reviewChanges",
        "title": "Review Changes",
        "category": "Kraft"
      },
      {
        "command": "kraft.review.addComment",
        "title": "Add Review Comment",
        "category": "Kraft"
      },
      {
        "command": "kraft.review.submit",
        "title": "Submit Review",
        "category": "Kraft",
        "icon": "$(send)"
      },
      {
        "command": "kraft.review.discard",
        "title": "Discard Review Comments",
        "category": "Kraft"
      },
      {
        "command": "kraft.review.editComment",
        "title": "Edit",
        "category": "Kraft",
        "icon": "$(edit)"
      },
      {
        "command": "kraft.review.saveComment",
        "title": "Save",
        "category": "Kraft"
      },
      {
        "command": "kraft.review.cancelEdit",
        "title": "Cancel",
        "category": "Kraft"
      },
      {
        "command": "kraft.review.deleteComment",
        "title": "Delete",
        "category": "Kraft",
        "icon": "$(trash)"
      },
      {
        "command": "kraft.review.setLabel",
        "title": "Set Label\u2026",
        "category": "Kraft",
        "icon": "$(tag)"
      },
      {
        "command": "kraft.review.resolveThread",
        "title": "Resolve",
        "category": "Kraft",
        "icon": "$(check)"
      },
      {
        "command": "kraft.review.reopenThread",
        "title": "Reopen",
        "category": "Kraft",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "kraft.review.otherThreads",
        "title": "Show Threads Not on a File in This Review",
        "category": "Kraft",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "kraft.lintLibrary",
        "title": "Lint Template Library",
        "category": "Kraft"
      },
      {
        "command": "kraft.showResolved",
        "title": "Show Resolved Chain",
        "category": "Kraft"
      },
      {
        "command": "kraft.fileWork",
        "title": "File Work Item\u2026",
        "category": "Kraft",
        "icon": "$(add)"
      },
      {
        "command": "kraft.fileAsSpec",
        "title": "File as Kraft Spec\u2026",
        "category": "Kraft"
      },
      {
        "command": "kraft.fileAsPlan",
        "title": "File as Kraft Plan\u2026",
        "category": "Kraft"
      },
      {
        "command": "kraft.fileSelection",
        "title": "File Selection as Kraft Work\u2026",
        "category": "Kraft"
      }
    ],
    "viewsWelcome": [
      {
        "view": "kraft.board",
        "contents": "No Kraft work in this repo. [Show all repos](command:kraft.toggleAllRepos)",
        "when": "kraft.welcome == here"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kraft.fileWork",
          "when": "view == kraft.board && !kraft.readOnly",
          "group": "navigation"
        },
        {
          "command": "kraft.toggleAllRepos",
          "when": "view == kraft.board",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "kraft.openArtifact",
          "when": "view == kraft.board && viewItem =~ /\\bgate\\b/",
          "group": "0_gate"
        },
        {
          "command": "kraft.approve",
          "when": "view == kraft.board && viewItem =~ /\\bapprove\\b/ && !kraft.readOnly",
          "group": "0_gate"
        },
        {
          "command": "kraft.reject",
          "when": "view == kraft.board && viewItem =~ /\\breject\\b/ && !kraft.readOnly",
          "group": "0_gate"
        },
        {
          "command": "kraft.pause",
          "when": "view == kraft.board && viewItem =~ /\\bpause\\b/ && !kraft.readOnly",
          "group": "1_act"
        },
        {
          "command": "kraft.resume",
          "when": "view == kraft.board && viewItem =~ /\\bresume\\b/ && !kraft.readOnly",
          "group": "1_act"
        },
        {
          "command": "kraft.retry",
          "when": "view == kraft.board && viewItem =~ /\\bretry\\b/ && !kraft.readOnly",
          "group": "1_act"
        },
        {
          "command": "kraft.raiseBudget",
          "when": "view == kraft.board && viewItem =~ /\\braise_budget\\b/ && !kraft.readOnly",
          "group": "1_act"
        },
        {
          "command": "kraft.unblock",
          "when": "view == kraft.board && viewItem =~ /\\bunblock\\b/ && !kraft.readOnly",
          "group": "1_act"
        },
        {
          "command": "kraft.skip",
          "when": "view == kraft.board && viewItem =~ /\\bskip\\b/ && !kraft.readOnly",
          "group": "1_act"
        },
        {
          "command": "kraft.escalate",
          "when": "view == kraft.board && viewItem =~ /\\bescalate\\b/ && !kraft.readOnly",
          "group": "1_act"
        },
        {
          "command": "kraft.cancel",
          "when": "view == kraft.board && viewItem =~ /\\bcancel\\b/ && !kraft.readOnly",
          "group": "2_end"
        },
        {
          "command": "kraft.complete",
          "when": "view == kraft.board && viewItem =~ /\\bcomplete\\b/ && !kraft.readOnly",
          "group": "2_end"
        },
        {
          "command": "kraft.archive",
          "when": "view == kraft.board && viewItem =~ /\\barchive\\b/ && !kraft.readOnly",
          "group": "2_end"
        },
        {
          "command": "kraft.restore",
          "when": "view == kraft.board && viewItem =~ /\\brestore\\b/ && !kraft.readOnly",
          "group": "2_end"
        },
        {
          "command": "kraft.openWorktree",
          "when": "view == kraft.board && viewItem =~ /\\bworktree\\b/",
          "group": "3_open"
        },
        {
          "command": "kraft.openInWebUi",
          "when": "view == kraft.board && viewItem =~ /^item:/",
          "group": "3_open"
        },
        {
          "command": "kraft.showWorkerLog",
          "when": "view == kraft.board && viewItem =~ /^item:/",
          "group": "3_open"
        },
        {
          "command": "kraft.openMergeRequest",
          "when": "view == kraft.board && viewItem =~ /\\bmr\\b/",
          "group": "3_open"
        },
        {
          "command": "kraft.openSpec",
          "when": "view == kraft.board && viewItem =~ /\\battSpec\\b/",
          "group": "3_open"
        },
        {
          "command": "kraft.openPlan",
          "when": "view == kraft.board && viewItem =~ /\\battPlan\\b/",
          "group": "3_open"
        },
        {
          "command": "kraft.reviewChanges",
          "when": "view == kraft.board && viewItem =~ /^item:/",
          "group": "3_open"
        },
        {
          "command": "kraft.review.submit",
          "when": "view == kraft.board && viewItem =~ /^item:/ && !kraft.readOnly",
          "group": "4_review"
        },
        {
          "command": "kraft.review.discard",
          "when": "view == kraft.board && viewItem =~ /^item:/ && !kraft.readOnly",
          "group": "4_review"
        }
      ],
      "explorer/context": [
        {
          "command": "kraft.fileAsSpec",
          "when": "resourceExtname == .md && !explorerResourceIsFolder && !kraft.readOnly",
          "group": "7_kraft"
        },
        {
          "command": "kraft.fileAsPlan",
          "when": "resourceExtname == .md && !explorerResourceIsFolder && !kraft.readOnly",
          "group": "7_kraft"
        }
      ],
      "editor/context": [
        {
          "command": "kraft.fileSelection",
          "when": "editorHasSelection && !kraft.readOnly",
          "group": "7_kraft"
        }
      ],
      "commandPalette": [
        {
          "command": "kraft.statusMenu",
          "when": "false"
        },
        {
          "command": "kraft.pause",
          "when": "false"
        },
        {
          "command": "kraft.resume",
          "when": "false"
        },
        {
          "command": "kraft.retry",
          "when": "false"
        },
        {
          "command": "kraft.cancel",
          "when": "false"
        },
        {
          "command": "kraft.skip",
          "when": "false"
        },
        {
          "command": "kraft.escalate",
          "when": "false"
        },
        {
          "command": "kraft.archive",
          "when": "false"
        },
        {
          "command": "kraft.raiseBudget",
          "when": "false"
        },
        {
          "command": "kraft.unblock",
          "when": "false"
        },
        {
          "command": "kraft.complete",
          "when": "false"
        },
        {
          "command": "kraft.restore",
          "when": "false"
        },
        {
          "command": "kraft.openWorktree",
          "when": "false"
        },
        {
          "command": "kraft.openInWebUi",
          "when": "false"
        },
        {
          "command": "kraft.showWorkerLog",
          "when": "false"
        },
        {
          "command": "kraft.openMergeRequest",
          "when": "false"
        },
        {
          "command": "kraft.openSpec",
          "when": "false"
        },
        {
          "command": "kraft.openPlan",
          "when": "false"
        },
        {
          "command": "kraft.openArtifact",
          "when": "false"
        },
        {
          "command": "kraft.approve",
          "when": "resourceScheme == kraft-artifact"
        },
        {
          "command": "kraft.reject",
          "when": "resourceScheme == kraft-artifact"
        },
        {
          "command": "kraft.reviewChanges",
          "when": "false"
        },
        {
          "command": "kraft.review.addComment",
          "when": "false"
        },
        {
          "command": "kraft.review.submit",
          "when": "false"
        },
        {
          "command": "kraft.review.discard",
          "when": "false"
        },
        {
          "command": "kraft.review.editComment",
          "when": "false"
        },
        {
          "command": "kraft.review.saveComment",
          "when": "false"
        },
        {
          "command": "kraft.review.cancelEdit",
          "when": "false"
        },
        {
          "command": "kraft.review.deleteComment",
          "when": "false"
        },
        {
          "command": "kraft.review.setLabel",
          "when": "false"
        },
        {
          "command": "kraft.review.resolveThread",
          "when": "false"
        },
        {
          "command": "kraft.review.reopenThread",
          "when": "false"
        },
        {
          "command": "kraft.review.otherThreads",
          "when": "false"
        },
        {
          "command": "kraft.lintLibrary",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "kraft.showResolved",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "kraft.fileWork",
          "when": "!kraft.readOnly"
        },
        {
          "command": "kraft.fileAsSpec",
          "when": "false"
        },
        {
          "command": "kraft.fileAsPlan",
          "when": "false"
        },
        {
          "command": "kraft.fileSelection",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "kraft.approve",
          "when": "resourceScheme == kraft-artifact && !kraft.readOnly",
          "group": "navigation@1"
        },
        {
          "command": "kraft.reject",
          "when": "resourceScheme == kraft-artifact && !kraft.readOnly",
          "group": "navigation@2"
        },
        {
          "command": "kraft.reviewChanges",
          "when": "resourceScheme == kraft-artifact",
          "group": "navigation@3"
        },
        {
          "command": "kraft.review.submit",
          "when": "resourceScheme =~ /^kraft-(wt|git|artifact)$/ && !kraft.readOnly",
          "group": "navigation@4"
        },
        {
          "command": "kraft.review.otherThreads",
          "when": "resourceScheme =~ /^kraft-(wt|git)$/",
          "group": "navigation@5"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "kraft.review.addComment",
          "group": "inline",
          "when": "commentController == kraft.review && !kraft.readOnly"
        }
      ],
      "comments/comment/title": [
        {
          "command": "kraft.review.editComment",
          "group": "inline@1",
          "when": "commentController == kraft.review && comment =~ /\\bmine-draft\\b/ && !kraft.readOnly"
        },
        {
          "command": "kraft.review.deleteComment",
          "group": "inline@2",
          "when": "commentController == kraft.review && comment =~ /\\bmine-draft\\b/ && !kraft.readOnly"
        }
      ],
      "comments/comment/context": [
        {
          "command": "kraft.review.saveComment",
          "group": "inline@1",
          "when": "commentController == kraft.review && !kraft.readOnly"
        },
        {
          "command": "kraft.review.cancelEdit",
          "group": "inline@2",
          "when": "commentController == kraft.review"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "kraft.review.setLabel",
          "group": "inline@1",
          "when": "commentController == kraft.review && commentThread =~ /\\bcan-label\\b/ && !kraft.readOnly"
        },
        {
          "command": "kraft.review.resolveThread",
          "group": "inline@2",
          "when": "commentController == kraft.review && commentThread =~ /\\bcan-resolve\\b/ && !kraft.readOnly"
        },
        {
          "command": "kraft.review.reopenThread",
          "group": "inline@3",
          "when": "commentController == kraft.review && commentThread =~ /\\bcan-reopen\\b/ && !kraft.readOnly"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "vscode:prepublish": "node esbuild.mjs --production",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && tsc -p tsconfig.test.json && node test/integration/runner.mjs",
    "package": "vsce package"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@types/ws": "^8.18.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.0",
    "mocha": "^11.0.0",
    "ovsx": "^1.2.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.1.2"
  }
}
