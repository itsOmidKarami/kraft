{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ca_bundle": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ca Bundle"
    },
    "cli": {
      "anyOf": [
        {
          "enum": [
            "docker",
            "podman"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cli"
    },
    "selinux": {
      "default": "auto",
      "enum": [
        "auto",
        "relabel",
        "disable"
      ],
      "title": "Selinux",
      "type": "string"
    }
  },
  "title": "Kraft sandbox host",
  "type": "object"
}
