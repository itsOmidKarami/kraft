{
  "$defs": {
    "LocalWorker": {
      "additionalProperties": false,
      "description": "The local worker's settings, a top-level `local:` key: it is not a machine\nunder `workers:`, so the name and connection rules above do not apply to it.\nUnset `capacity` means no limit.",
      "properties": {
        "capacity": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity"
        },
        "groups": {
          "items": {
            "type": "string"
          },
          "title": "Groups",
          "type": "array"
        }
      },
      "title": "LocalWorker",
      "type": "object"
    },
    "Worker": {
      "additionalProperties": false,
      "properties": {
        "capacity": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity"
        },
        "give_up_after": {
          "default": "2h",
          "title": "Give Up After",
          "type": "string"
        },
        "groups": {
          "items": {
            "type": "string"
          },
          "title": "Groups",
          "type": "array"
        },
        "repos": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repos"
        },
        "ssh": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ssh"
        },
        "token_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Sha256"
        }
      },
      "title": "Worker",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "local": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalWorker"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workers": {
      "additionalProperties": {
        "$ref": "#/$defs/Worker"
      },
      "title": "Workers",
      "type": "object"
    }
  },
  "title": "Kraft remote workers",
  "type": "object"
}
