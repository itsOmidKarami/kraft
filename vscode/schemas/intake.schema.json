{
  "$defs": {
    "Schedule": {
      "additionalProperties": false,
      "description": "One `schedules:` entry of `intake.yaml`: a cron that files a work item,\npaused, as `kraft item create` would (`triggers.tick`).",
      "properties": {
        "chain": {
          "title": "Chain",
          "type": "string"
        },
        "cron": {
          "title": "Cron",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "cron",
        "repo",
        "chain",
        "title"
      ],
      "title": "Schedule",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "default": false,
      "title": "Enabled",
      "type": "boolean"
    },
    "interval_s": {
      "default": 300,
      "title": "Interval S",
      "type": "integer"
    },
    "priority_ceiling": {
      "default": 2,
      "title": "Priority Ceiling",
      "type": "integer"
    },
    "repos": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Repos",
      "type": "array"
    },
    "schedules": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Schedule"
      },
      "title": "Schedules",
      "type": "array"
    }
  },
  "title": "Kraft intake",
  "type": "object"
}
