        "skippable": {
          "default": true,
          "title": "Skippable",
          "type": "boolean"
        },
        "steering": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "title": "Steering",
          "type": "array"
        }
      },
      "title": "BuiltinTask",
      "type": "object"
    },
