        "id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "exec",
          "title": "Kind",
          "type": "string"
        },
        "on_base_changed": {
          "anyOf": [
            {
              "$ref": "#/$defs/BaseChangePolicy"
