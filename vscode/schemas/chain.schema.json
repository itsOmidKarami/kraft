{
  "$defs": {
    "AgentInput": {
      "description": "What Kraft hands an agent task beyond its prompt, when the task asks for\nit by name. Declared on the task rather than keyed on a task's name or\nrole, which is the indirection V1 deletes (Ruling 47).\n\n* `review_package` -- the change under review written out to a file, its\n  path in `$KRAFT_REVIEW_PACKAGE`: the whole branch since `base_ref`, then\n  from a task's second session on only what changed since its previous\n  one (`review-package-is-delivered-to-a-task-that-declares-it`).\n* `carried_findings` -- the findings the node's last measurement reported,\n  each with its stable tag, so a reworded repeat can be reported as the\n  same finding (`carried-findings-are-delivered-to-a-reviewing-task`).\n* `previous_review` -- the task's own previous completed session's result\n  file and summary, by path\n  (`continuity-note-is-delivered-to-a-resumed-reviewer`).",
      "enum": [
        "review_package",
        "carried_findings",
        "previous_review"
      ],
      "title": "AgentInput",
      "type": "string"
    },
    "AgentTask": {
      "additionalProperties": false,
      "properties": {
        "effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "extends": {
          "description": "A library component of the same kind to inherit from; this one's own keys win.",
          "type": "string"
        },
        "fallback": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/FallbackEntry"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback"
        },
        "harness": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Harness",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/AgentInput"
          },
          "title": "Inputs",
          "type": "array"
        },
        "kind": {
          "const": "agent",
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "on_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskPolicyOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "produces": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Produces"
        },
        "profile": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/TaskScope",
          "default": "once"
        },
        "skill": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill"
        },
        "skippable": {
          "default": true,
          "title": "Skippable",
          "type": "boolean"
        },
        "steering": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "title": "Steering",
          "type": "array"
        }
      },
      "title": "AgentTask",
      "type": "object"
    },
    "BaseChangePolicy": {
      "additionalProperties": false,
      "description": "`on_base_changed`: what an execution node does when its own work moves\nthe worktree base (`base-change-restarts-a-declared-chain-span`).\n\n`restart_from` names the execution node the chain restarts at -- this one\nor an earlier one, never a later one or a gate (`base-change-restart-\ntarget-is-backward`, checked by `Chain`, which alone can see the order).\n\n`on_conflict` is the only way Kraft attempts to resolve a rebase conflict\n(`rebase-conflict-requires-explicit-handler`): a recovery-shaped handler,\nrun when a task of this node fails on a conflict. Absent, a conflict is an\nordinary task failure.",
      "properties": {
        "on_conflict": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "restart_from": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Restart From",
          "type": "string"
        }
      },
      "title": "BaseChangePolicy",
      "type": "object"
    },
    "BuiltinAction": {
      "description": "What a `kind: builtin` task's `ref` may name\n(`builtin-task-references-code-owned-actions`: Kraft owns this vocabulary,\nso an unsupported reference is rejected by the type). Grows one member per\naction a later phase actually wires up.",
      "enum": [
        "kraft.verify_changed_test_scopes",
        "kraft.mr_rebase"
      ],
      "title": "BuiltinAction",
      "type": "string"
    },
