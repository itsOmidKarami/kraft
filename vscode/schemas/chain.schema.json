                },
                {
                  "$ref": "#/$defs/SubprocessTask"
                },
                {
                  "$ref": "#/$defs/ForgeTask"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Escalation"
        },
        "extends": {
          "description": "A library component of the same kind to inherit from; this one's own keys win.",
          "type": "string"
        },
        "fix_loop": {
