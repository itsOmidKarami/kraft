{
  "$defs": {
    "AutomatedReview": {
      "additionalProperties": false,
      "description": "`automated_review:` on a repository: the one reviewer whose verdict\n`mr.automated_review` waits for, named exactly one way.\n\n* `bot` -- a forge login. The review settles when that login has reviewed\n  the merge request's current head.\n* `check` -- a check or commit status on the head. It settles when that\n  check completes.\n\nAbsent, the repository expects no automated reviewer, and the wait settles\nclean at once (`automated_review_not_configured`). How either is read is the\nforge backend's (`automated-review-implementation-is-not-template-\nconfiguration`): this names *which* reviewer, never how to ask it.",
      "properties": {
        "bot": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bot"
        },
        "check": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check"
        }
      },
      "title": "AutomatedReview",
      "type": "object"
    },
    "CredentialInject": {
      "additionalProperties": false,
      "description": "Where the egress proxy puts a credential: `header` on every request\nto exactly `domain`, set to `format` with the value at its `%s`\n(`Bearer %s` for `Authorization`; unset, the value alone).",
      "properties": {
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "header": {
          "title": "Header",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "header"
      ],
      "title": "CredentialInject",
      "type": "object"
    },
    "NetworkPhase": {
      "additionalProperties": false,
      "description": "One phase's allow and deny lists. Deny wins; an empty allow grants\nnothing.",
      "properties": {
        "allow": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allow",
          "type": "array"
        },
        "deny": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Deny",
          "type": "array"
        }
      },
      "title": "NetworkPhase",
      "type": "object"
    },
    "RepoEntry": {
      "additionalProperties": true,
      "description": "One `repos.yaml` entry. Strict, so `managed: \"true\"` is rejected as the\nhand-rolled loader rejected it; unknown keys ride along (`extra=\"allow\"`)\nbecause entries carry keys this loader never read (`name`, `enabled`,\n`default_chain`, ...) and a re-save must not drop them.",
      "properties": {
        "areas": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "default": {},
          "title": "Areas",
          "type": "object"
        },
        "automated_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/AutomatedReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ci_checks": {
          "default": true,
          "title": "Ci Checks",
          "type": "boolean"
        },
        "default_chain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Chain"
        },
        "deny_tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Deny Tools",
          "type": "array"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Env",
          "type": "object"
        },
        "env_passthrough": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Env Passthrough",
          "type": "array"
        },
        "forge": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forge"
        },
        "id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "intent_dir": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intent Dir"
        },
        "local_files": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Local Files",
          "type": "array"
        },
        "managed": {
          "default": true,
          "title": "Managed",
          "type": "boolean"
        },
        "models": {
          "default": {},
          "patternProperties": {
            "^[a-z][a-z0-9_-]*$": {
              "type": "string"
            }
          },
          "title": "Models",
          "type": "object"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemplatePolicyOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "sandbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/SandboxPolicy"
            },
            {
              "const": false,
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sandbox"
        },
        "setup_command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Setup Command"
        },
        "steering": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Steering",
          "type": "array"
        },
        "test_command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Command"
        },
        "test_scopes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/TestScope"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Scopes"
        }
      },
      "required": [
        "path"
      ],
      "title": "RepoEntry",
      "type": "object"
    },
    "SandboxCredential": {
      "additionalProperties": false,
      "description": "One proxy-managed credential (credential@1's apiKey subset, spec \u00a76):\nthe container's `env` holds `sentinel`, and the egress proxy puts the\ndaemon's own value where `inject` says. Just `env:` names one a harness\ndeclares, which supplies the rest; a repository's own credential says\nit all. A name left out of `credentials` passes through as it always did.",
      "properties": {
        "env": {
          "title": "Env",
          "type": "string"
        },
        "inject": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CredentialInject"
          },
          "title": "Inject",
          "type": "array"
        },
        "phase": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "install",
                  "runtime"
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "sentinel": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentinel"
        },
        "service": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "env"
      ],
      "title": "SandboxCredential",
      "type": "object"
    },
    "SandboxNetwork": {
      "additionalProperties": false,
      "description": "`network:`: deny-by-default egress for a sandboxed launch.\n`install` binds the setup command, `runtime` an agent session, which also\ngets its harness's own `network.requires` hosts (unioned at launch, never\nstored here). A phase left out grants nothing. Frozen, with tuples, like\n`SandboxResources`: `SandboxPolicy` is hashed and locked whole.",
      "properties": {
        "install": {
          "$ref": "#/$defs/NetworkPhase",
          "default": {}
        },
        "runtime": {
          "$ref": "#/$defs/NetworkPhase",
          "default": {}
        }
      },
      "title": "SandboxNetwork",
      "type": "object"
    },
    "SandboxPolicy": {
      "additionalProperties": false,
      "description": "Where a task's process runs: `kind: docker` in `image`, within\n`resources` and reaching only what `network` allows\n(`kraft.worker.backends`), with `credentials` managed by the egress\nproxy; or `kind: kit`, a Kit pinned by digest that sets all of those\nitself and is lowered to `kind: docker` at launch (`worker.kit.lower`).\nA permission-shaped safety field (Ruling 105): once a layer sets one, no\nnarrower layer may change or remove it -- the whole value, `resources`,\n`network`, `credentials` and a Kit's reference included.",
      "properties": {
        "credentials": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SandboxCredential"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credentials"
        },
        "image": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "kind": {
          "enum": [
            "docker",
            "kit"
          ],
          "title": "Kind",
          "type": "string"
        },
        "kit": {
          "anyOf": [
            {
              "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kit"
        },
        "network": {
          "anyOf": [
            {
              "$ref": "#/$defs/SandboxNetwork"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resources": {
          "anyOf": [
            {
              "$ref": "#/$defs/SandboxResources"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runtime": {
          "anyOf": [
            {
              "const": "docker",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime"
        },
        "unrestricted_network": {
          "default": false,
          "title": "Unrestricted Network",
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SandboxPolicy",
      "type": "object"
    },
    "SandboxResources": {
      "additionalProperties": false,
      "description": "What a sandboxed launch may use: `cpu` (CPUs, fractions allowed),\n`memory` (a hard limit, swap too where it can be) and `pids` (processes and\nthreads). A limit that is set is applied or the launch is refused\n(`sandbox-limits-never-silently-drop`); unset `pids` is 4096 wherever\nthe runtime can enforce it. Frozen, like `SandboxPolicy`, which is hashed\nwhole.",
      "properties": {
        "cpu": {
          "anyOf": [
            {
              "minimum": 0.01,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu"
        },
        "memory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory"
        },
        "pids": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pids"
        }
      },
      "title": "SandboxResources",
      "type": "object"
    },
    "TemplatePolicyOverride": {
      "additionalProperties": false,
      "description": "A repository, work-item, chain or execution-node override: a task's\nfields plus the two that bound a node's fix loop (`walk.walk_node`) --\n`max_attempts`, its attempt cap, and `timeout_minutes`, its wall clock.",
      "properties": {
        "allowed_harnesses": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Harnesses"
        },
        "allowed_tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Tools"
        },
        "budget_usd": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                }
              ],
              "gt": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Usd"
        },
        "deny_tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deny Tools"
        },
        "escalation_harness": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Escalation Harness"
        },
        "grants": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grants"
        },
        "max_attempts": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Attempts"
        },
        "sandbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/SandboxPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "time_cap_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Cap Minutes"
        },
        "timeout_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Minutes"
        },
        "token_budget": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Budget"
        },
        "total_time_cap_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Time Cap Minutes"
        }
      },
      "title": "TemplatePolicyOverride",
      "type": "object"
    },
    "TestScope": {
      "additionalProperties": true,
      "description": "One `test_scopes` entry. Not asserted as a pytest class.",
      "properties": {
        "command": {
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Paths",
          "type": "array"
        }
      },
      "required": [
        "paths",
        "command"
      ],
      "title": "TestScope",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "repos": {
      "items": {
        "$ref": "#/$defs/RepoEntry"
      },
      "type": "array"
    }
  },
  "title": "Kraft connected repositories",
  "type": "object"
}
