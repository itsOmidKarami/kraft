{
  "$defs": {
    "ForgeAccount": {
      "additionalProperties": false,
      "properties": {
        "api_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Url"
        },
        "ca_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ca File"
        },
        "client": {
          "default": "cli",
          "enum": [
            "cli",
            "api"
          ],
          "title": "Client",
          "type": "string"
        },
        "default_for_host": {
          "default": false,
          "title": "Default For Host",
          "type": "boolean"
        },
        "forge": {
          "enum": [
            "github",
            "gitlab"
          ],
          "title": "Forge",
          "type": "string"
        },
        "token": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "web_url": {
          "title": "Web Url",
          "type": "string"
        }
      },
      "required": [
        "forge",
        "web_url"
      ],
      "title": "ForgeAccount",
      "type": "object"
    },
    "TokenSource": {
      "additionalProperties": false,
      "description": "Where an API account's token comes from. Holds a name or a path, never the token.",
      "properties": {
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Env"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "from": {
          "default": "git-credential",
          "enum": [
            "git-credential",
            "command",
            "env",
            "file"
          ],
          "title": "From",
          "type": "string"
        },
        "kind": {
          "default": "unknown",
          "enum": [
            "pat",
            "oauth",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "TokenSource",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accounts": {
      "additionalProperties": {
        "$ref": "#/$defs/ForgeAccount"
      },
      "default": {},
      "title": "Accounts",
      "type": "object"
    }
  },
  "title": "Kraft forge accounts",
  "type": "object"
}
