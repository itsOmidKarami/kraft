{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '\n  (.tool_input.command // \"\") as $c\n  | ($c | test(\"(^|&&|;|\\\\||\\\\n)\\\\s*(uv run python -m pytest|uv run pytest|python -m pytest|pytest)(\\\\s|$)\")) as $isPytest\n  | if $isPytest then\n      {hookSpecificOutput:{hookEventName:\"PreToolUse\",permissionDecision:\"deny\",permissionDecisionReason:\"Blocked: raw pytest bypasses testmon change-tracking. Use `just test` instead (add -k pattern to target tests, or --no-testmon for a full run).\"}}\n    else\n      {}\n    end\n'"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/kraft-worker-plugins.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/kraft-worker-plugins.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/kraft-worker-plugins.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "ponytail@ponytail": true,
    "techdocs-authoring@techdocs-authoring": true,
    "engineering@knowledge-work-plugins": true,
    "design@knowledge-work-plugins": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "techdocs-authoring": {
      "source": {
        "source": "github",
        "repo": "pkloehn1/techdocs-authoring"
      }
    },
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    }
  }
}
