
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

.kraft-run/

# Python build artifacts
__pycache__/
*.egg-info/
dist/
build/
*.pyc
.venv/
.pytest_cache/
.testmondata*
.ruff_cache/
.uv-cache/

# macOS
.DS_Store

# Frontend (Vite SPA)
node_modules/
*.tsbuildinfo
frontend/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
frontend/e2e-shots/

# Design exports ship as zips next to the handoffs they came from; the handoff
# folders are the versioned copy.
design/**/*.zip

# Written by Settings → Access and Settings → Notify. Everything else the
# Settings screens write is versioned on purpose; these hold a password hash,
# a bind address, and a webhook URL that are per-machine, so they stay local.
templates/access.yaml
templates/notify.yaml

# Subagent-driven-development scratch: ledgers, briefs, review packages.
.superpowers/

# Dev instance home (`just dev`) and the build outputs `just install` copies in
.dev/
src/kraft/_bundled/

# Kraft Lite run state. The registry beside it is committed on purpose.
.kraft-lite/chain.json
.kraft-lite/chains/
.kraft-lite/chain.jsonl

# Kraft's own artifacts -- specs, plans, chain reviews, review briefs, session
# summaries. Since MR113 these are ingested straight into Kraft's index
# (Indexer.ingest_gate_artifact) and never meant to land in the connected
# repo's git history; a worker's end-of-session `git add -A` was still
# scooping them up because only sessions/ was ignored here.
.engineering/
docs/superpowers/

# The maintainer's half of the agent instructions: bd workflow, session
# protocol. `## Kraft Workers` is NOT in here -- it stays in the public
# CLAUDE.md/AGENTS.md, see Task 6's note above. CLAUDE.md imports the first
# with `@`; AGENTS.md points at the second in prose.
CLAUDE.local.md
AGENTS.local.md

# Agent worktrees. This was covered only by .git/info/exclude, which is local to
# one clone and never travels -- so a fresh clone, or anyone else's, had nothing
# stopping `git add -A` from committing an entire worktree.
.claude/worktrees/

# Design-time material, kept private when the repo went public: the Claude
# Design canvases and sweep frames, and the historical design record the
# intent tree was backfilled from. Both live in the private GitLab archive.
design/
docs/consolidated/

# Beads' interaction log: issue ids, status transitions and the reasons written
# on them. The issue database itself is not in git at all -- it lives in
# .beads/embeddeddolt/ and syncs over refs/dolt/data to a private remote.
.beads/interactions.jsonl
