{
  "id": "slice",
  "nodes": [
    {
      "id": "implementation",
      "tasks": [
        "on.mr.rebase",
        "on.env.prepare",
        "on.slice.implementation.start",
        "on.repos.scan"
      ],
      "gate_after": null,
      "fix_loop": null
    },
    {
      "id": "verify",
      "tasks": [
        "on.mr.rebase",
        "on.env.prepare",
        "on.slice.test.run",
        "on.review.local.run"
      ],
      "gate_after": null,
      "fix_loop": "verify_fix_loop"
    },
    {
      "id": "open_mr",
      "tasks": [
        "on.mr.rebase",
        "on.mr.describe",
        "on.mr.open"
      ],
      "gate_after": null,
      "fix_loop": null
    },
    {
      "id": "mr_checks",
      "tasks": [
        "on.ci.poll"
      ],
      "gate_after": null,
      "fix_loop": "ci_fix_loop"
    }
  ],
  "loops": {
    "verify_fix_loop": {
      "attempts": 3
    },
    "ci_fix_loop": {
      "attempts": 3
    }
  }
}
