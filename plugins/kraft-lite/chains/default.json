{
  "id": "default",
  "nodes": [
    {
      "id": "spec",
      "tasks": [
        "on.mr.rebase",
        "on.spec.requested"
      ],
      "gate_after": "spec_approval",
      "fix_loop": null
    },
    {
      "id": "plan",
      "tasks": [
        "on.mr.rebase",
        "on.plan.requested"
      ],
      "gate_after": "plan_approval",
      "fix_loop": null
    },
    {
      "id": "chain_review",
      "tasks": [
        "on.chain.review_ready"
      ],
      "gate_after": "chain_finalized",
      "fix_loop": null
    },
    {
      "id": "implementation",
      "tasks": [
        "on.mr.rebase",
        "on.env.prepare",
        "on.implementation.start",
        "on.repos.scan"
      ],
      "gate_after": null,
      "fix_loop": null
    },
    {
      "id": "verify",
      "tasks": [
        "on.mr.rebase",
        "on.env.prepare",
        "on.test.run",
        "on.review.local.run"
      ],
      "gate_after": null,
      "fix_loop": "verify_fix_loop"
    },
    {
      "id": "open_mr",
      "tasks": [
        "on.mr.rebase",
        "on.mr.describe",
        "on.mr.open"
      ],
      "gate_after": null,
      "fix_loop": null
    },
    {
      "id": "mr_checks",
      "tasks": [
        "on.ci.poll",
        "on.review.mr.run"
      ],
      "gate_after": null,
      "fix_loop": "ci_fix_loop"
    },
    {
      "id": "human_review",
      "tasks": [
        "on.human_review.requested"
      ],
      "gate_after": "human_review_approval",
      "fix_loop": null
    },
    {
      "id": "merge",
      "tasks": [
        "on.mr.sync",
        "on.merge"
      ],
      "gate_after": null,
      "fix_loop": null
    },
    {
      "id": "post_merge_watch",
      "tasks": [
        "on.merge.watch"
      ],
      "gate_after": null,
      "fix_loop": null
    }
  ],
  "loops": {
    "verify_fix_loop": {
      "attempts": 3
    },
    "ci_fix_loop": {
      "attempts": 3
    }
  }
}
