/* The console's layout. Colours come from the theme (`theme.py`, generated by
 * dev/gen_theme.py): Textual's slots, and `$kraft-*` for the rest. */

Screen {
    background: $background;
}

#top {
    height: 1;
    background: $kraft-side;
}

/* The tabs win the line; the repo and version give way, then go (narrow). */
#tabs {
    width: auto;
}

#where {
    width: 1fr;
    text-align: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    color: $kraft-muted;
}

Screen.-narrow #where {
    display: none;
}

ContentSwitcher {
    height: 1fr;
}

#down, #tiny, #narrow-keys {
    display: none;
}

/* No server, or the token refused: the message replaces every view. */
Screen.-down ContentSwitcher {
    display: none;
}

Screen.-down #down {
    display: block;
    height: auto;
    padding: 1 2;
}

/* Only when nothing answers, and only for a server on this machine. */
#start {
    display: none;
    margin: 0 2;
}

Screen.-no-server #start {
    display: block;
}

/* Docked, so it stays above the footer when the no-server message replaces the views. */
#prompt {
    dock: bottom;
    margin-bottom: 1;
    border: none;
    height: 1;
    padding: 0 1;
    background: $kraft-side;
}

Screen.-narrow Footer {
    display: none;
}

Screen.-narrow #narrow-keys {
    display: block;
    dock: bottom;
    height: 1;
    color: $kraft-muted;
}

/* Too small to draw anything well: say so instead of drawing it clipped. */
Screen.-tiny > * {
    display: none;
}

/* Ids outrank the bare `> *`, and `-down` and `-narrow` name ids too. */
Screen.-tiny #down,
Screen.-tiny #start,
Screen.-tiny #prompt,
Screen.-tiny #narrow-keys {
    display: none;
}

Screen.-tiny #tiny {
    display: block;
}

/* The Board: a filter line when asked for, and the rows. */
#board-filter {
    height: 1;
    border: none;
    padding: 0 1;
    background: $kraft-side;
}

#rows {
    height: 1fr;
    max-height: 100%;
    border: none;
    padding: 0;
    scrollbar-gutter: stable;
    background: $background;
}

#rows > .option-list--option-highlighted {
    background: $primary 12%;
    text-style: bold;
}

/* The peek: the bottom third of the Board, on the surface. */
#peek {
    height: 33%;
    background: $surface;
    border-top: solid $kraft-line;
}

#peek-head, #peek-chain {
    height: 1;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#peek-body {
    height: 1fr;
    padding: 0 1;
    background: $surface;
}

/* The output panel: above the prompt and footer, which stay in sight. */
OutputPanel {
    align: center bottom;
}

#output {
    height: 70%;
    margin-bottom: 2;
    background: $surface;
    border-top: solid $kraft-line;
}

#output-log {
    height: 1fr;
    background: $surface;
}

#output-bar {
    height: 1;
}

#output-bar Button {
    height: 1;
    min-width: 8;
    border: none;
}

#output-keys {
    width: 1fr;
    padding: 0 2;
    color: $kraft-muted;
}

Confirm {
    align: center middle;
}

#confirm {
    width: 72;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: solid $kraft-line;
}

#listing {
    margin: 1 0;
    color: $kraft-muted;
}

#confirm Horizontal {
    height: auto;
}

#confirm Button {
    margin-right: 2;
}
