/* The console's layout. Colours come from the theme (`theme.py`, generated by
 * dev/gen_theme.py): Textual's slots, and `$kraft-*` for the rest. */

Screen {
    background: $background;
}

/* A dialog keeps the screen it was opened over in sight, dimmed: the spec
 * you reject stays readable while you say why. After `Screen`, which a
 * ModalScreen also is. */
ModalScreen {
    background: $background 60%;
}

/* One cell, in the faint colour (the theme's `scrollbar`): never louder than
 * what it scrolls. */
* {
    scrollbar-size-vertical: 1;
}

#output-log, #confirm-scroll {
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
}

#top {
    height: 1;
    background: $kraft-side;
}

/* The tabs win the line; the repo and version give way, then go (narrow). */
#tabs {
    width: auto;
}

#where {
    width: 1fr;
    padding-left: 2;
    text-align: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    color: $kraft-muted;
}

Screen.-narrow #where {
    display: none;
}

/* What moved since the console was last closed (moments.since_line): for the
 * first minute, or until a key. */
#since {
    display: none;
    height: 1;
    color: $kraft-muted;
}

Screen.-since #since {
    display: block;
}

/* After an update installed another version: until the console restarts. */
#updated {
    display: none;
    height: auto;
    padding: 0 1;
    background: $surface;
    color: $warning;
}

Screen.-updated #updated {
    display: block;
}

ContentSwitcher {
    height: 1fr;
}

#down, #tiny {
    display: none;
}

/* No server, or the token refused: the message replaces every view. */
Screen.-down ContentSwitcher {
    display: none;
}

Screen.-down #down {
    display: block;
    height: auto;
    padding: 1 2;
}

/* Only when nothing answers, and only for a server on this machine. */
#start {
    display: none;
    margin: 0 2;
}

Screen.-no-server #start {
    display: block;
}

/* The prompt in its frame, the status line under it, then the footer. */
#dock {
    dock: bottom;
    height: auto;
    margin-bottom: 1;
}

#prompt-box {
    height: 3;
    padding: 0 1;
    border: round $kraft-frame;
    background: $background;
}

#prompt-box:focus-within {
    border: round $kraft-accent;
}

#prompt-mark {
    width: 2;
    color: $kraft-accent;
    text-style: bold;
}

#prompt {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: $background;
}

/* A short window keeps its rows for the work: the prompt is one line. */
Screen.-compact #prompt-box {
    height: 1;
    border: none;
    background: $kraft-side;
}

Screen.-compact #prompt {
    background: $kraft-side;
}

#status {
    height: 1;
    padding: 0 1;
}

#status-spin {
    margin: 0 1 0 1;
}

#status-text {
    width: 1fr;
    padding-left: 1;
    text-wrap: nowrap;
}

Screen.-narrow Footer {
    display: none;
}

/* The status line names `? keys` where the footer is hidden. */
Screen.-narrow #dock {
    margin-bottom: 0;
}

/* Too small to draw anything well: say so instead of drawing it clipped. */
Screen.-tiny > * {
    display: none;
}

/* Ids outrank the bare `> *`, and `-down` and `-narrow` name ids too. */
Screen.-tiny #since,
Screen.-tiny #updated,
Screen.-tiny #down,
Screen.-tiny #start,
Screen.-tiny #dock {
    display: none;
}

Screen.-tiny #tiny {
    display: block;
}

/* The Board: a filter line when asked for, and the rows. */
#board-filter,
#server-filter {
    height: 1;
    border: none;
    padding: 0 1;
    background: $kraft-side;
}

#rows, #repo-rows, #addon-rows {
    height: 1fr;
    max-height: 100%;
    border: none;
    padding: 0;
    scrollbar-gutter: stable;
    background: $background;
}

/* The Board's panel draws its own sides, the scroll position on the right
 * one. It is as tall as its rows; with the peek open, the peek takes the rest. */
#rows {
    height: auto;
    scrollbar-size-vertical: 0;
    /* Never shown (overflow-x is hidden), but an auto height counts it. */
    scrollbar-size-horizontal: 0;
}

Board.-peek #rows {
    max-height: 67%;
}

Screen.-compact #rows {
    scrollbar-size-vertical: 1;
}

#rows > .option-list--option-highlighted,
#repo-rows > .option-list--option-highlighted,
#addon-rows > .option-list--option-highlighted {
    background: $primary 12%;
    text-style: bold;
}

/* The peek: the bottom third of the Board, its own panel titled with the
 * item and its state. */
#peek {
    height: 1fr;
    min-height: 8;
    background: $background;
    border: round $kraft-frame;
    border-title-color: $kraft-accent;
    border-title-style: bold;
}

#peek-head, #peek-chain, #peek-work {
    height: 1;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#peek-body {
    height: 1fr;
    padding: 0 1;
    background: $background;
}

/* Panels in a short window: no top or bottom edge, the title on a rule. */
Screen.-compact #peek, Screen.-compact View.panel {
    border: none;
    border-top: solid $kraft-frame;
}

/* Server, Repos, Add-ons: each one panel, titled in its border. */
View.panel {
    padding: 0 1;
    border: round $kraft-frame;
    border-title-color: $kraft-accent;
    border-title-style: bold;
    border-subtitle-color: $kraft-muted;
}

/* The output panel: above the prompt and footer, which stay in sight. */
OutputPanel {
    align: center bottom;
}

#output {
    height: 70%;
    margin-bottom: 2;
    background: $surface;
    border-top: solid $kraft-line;
}

#output-log {
    height: 1fr;
    background: $surface;
}

#output-bar {
    height: 1;
}

#output-bar Button {
    height: 1;
    min-width: 8;
    border: none;
}

#output-keys {
    width: 1fr;
    padding: 0 2;
    color: $kraft-muted;
}

Confirm, Note, Menu, Connect, NewItem, Keys {
    align: center middle;
}

#keys-here {
    margin-bottom: 1;
}

#confirm, #note, #menu, #connect, #new-item, #keys {
    width: 72;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $kraft-frame;
}

/* A dialog's title, in the accent. */
#question, #note-question, #menu-title, #connect-title, #new-item-heading, .keys-head {
    color: $kraft-accent;
    text-style: bold;
}

/* After the dialogs' shared width: the keys need less, and scroll in a
 * window too short for them. */
#keys {
    width: 52;
}

/* Its frame and padding take 4 rows: three quarters leaves them room down to 16. */
#keys-scroll {
    height: auto;
    max-height: 75vh;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
}

#listing, #note-lines {
    margin: 1 0;
    color: $kraft-muted;
}

/* A listing past this many rows scrolls: the buttons stay in sight. */
#confirm-scroll {
    height: auto;
    max-height: 12;
}

#note Input {
    margin-top: 1;
}

#note-error {
    color: $error;
}

#confirm Horizontal {
    height: auto;
}

#confirm Button {
    margin-right: 2;
}

/* The Item: its header in a panel (two lines, the working line while it
 * runs, the banner when stopped, the chain, the tabs), then the tab's pane. */
#item-head {
    height: auto;
    border: round $kraft-frame;
    border-subtitle-color: $kraft-muted;
}

Screen.-compact #item-head {
    border: none;
}

#item-top, #item-state {
    height: 1;
}

#item-title, #item-status {
    width: 1fr;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#item-where, #item-spent {
    width: auto;
    padding: 0 1;
}

#item-title, #item-status, #item-chain, #item-tabs, #item-banner, #item-gone, #item-work {
    padding: 0 1;
}

#item-chain, #item-tabs {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* The reason wraps: a stop's way on is read whole. */
#item-banner {
    height: auto;
    background: $surface;
}

#item-tabs {
    height: 1;
}

Screen.-compact #item-tabs {
    border-bottom: solid $kraft-line;
    height: 2;
}

#item-panes, #item-panes > RichLog {
    height: 1fr;
}

#item-panes > RichLog {
    padding: 0 1;
    background: $background;
}

#note Select {
    margin-top: 1;
}

#menu OptionList {
    height: auto;
    margin-top: 1;
    border: none;
}

/* The Server: how it is, then `server.log` under a rule. */
#server-summary {
    height: auto;
    padding: 0 1;
}

#server-rule {
    margin-top: 1;
}

#server-log {
    height: 1fr;
    padding: 0 1;
    background: $background;
}

/* The connect form: path, test and setup, Verify, what the probe said. */
#connect Checkbox {
    border: none;
    height: 1;
}

/* Unfocused titles and the mark are secondary text, readable on the dialog's surface. */
#connect Input {
    border-title-color: $kraft-muted;
    border-title-background: $surface;
}

#connect Input:focus {
    border-title-color: $foreground;
}

/* The mark is `✓` or `·` (`Toggle`); its colour only repeats it. */
Toggle > .toggle--button {
    color: $kraft-muted;
    background: $surface;
}

Toggle.-on > .toggle--button {
    color: $success;
}

#connect-said, #connect-library {
    color: $kraft-muted;
}

#connect Horizontal {
    height: auto;
}

#connect Button {
    margin-right: 2;
}

/* New item: a line a field, the description three. */
.new-field {
    height: 1;
}

#new-description-row {
    height: 3;
}

.new-field > Static {
    width: 12;
    color: $kraft-muted;
}

.new-field > Input, .new-field > TextArea {
    width: 1fr;
}

#new-said {
    margin-top: 1;
}

#new-buttons {
    height: auto;
    margin-top: 1;
}

#new-buttons Button {
    margin-right: 2;
}
