/* The console's layout. Colours come from the theme (`theme.py`, generated by
 * dev/gen_theme.py): Textual's slots, and `$kraft-*` for the rest. */

Screen {
    background: $background;
}

#top {
    height: 1;
    background: $kraft-side;
}

/* The tabs win the line; the repo and version give way, then go (narrow). */
#tabs {
    width: auto;
}

#where {
    width: 1fr;
    text-align: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    color: $kraft-muted;
}

Screen.-narrow #where {
    display: none;
}

ContentSwitcher {
    height: 1fr;
}

#down, #tiny, #narrow-keys {
    display: none;
}

/* No server, or the token refused: the message replaces every view. */
Screen.-down ContentSwitcher {
    display: none;
}

Screen.-down #down {
    display: block;
    height: 1fr;
    padding: 1 2;
}

Screen.-narrow Footer {
    display: none;
}

Screen.-narrow #narrow-keys {
    display: block;
    dock: bottom;
    height: 1;
    color: $kraft-muted;
}

/* Too small to draw anything well: say so instead of drawing it clipped. */
Screen.-tiny > * {
    display: none;
}

/* Ids outrank the bare `> *`, and `-down` and `-narrow` name ids too. */
Screen.-tiny #down,
Screen.-tiny #narrow-keys {
    display: none;
}

Screen.-tiny #tiny {
    display: block;
}

/* The output panel: above the prompt and footer, which stay in sight. */
OutputPanel {
    align: center bottom;
}

#output {
    height: 70%;
    margin-bottom: 2;
    background: $surface;
    border-top: solid $kraft-line;
}

#output-log {
    height: 1fr;
    background: $surface;
}

#output-bar {
    height: 1;
}

#output-bar Button {
    height: 1;
    min-width: 8;
    border: none;
}

#output-keys {
    width: 1fr;
    padding: 0 2;
    color: $kraft-muted;
}
